# Maritime Surveillance System Configuration

# Video Ingestion
RTSP_STREAMS=rtsp://example.com:554/stream1,rtsp://example.com:554/stream2

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# Mistral/Ollama
MISTRAL_BASE_URL=http://mistral_ollama:11434

# CV Agent
FRAME_INPUT_DIR=/app/frames
THREAT_CONFIDENCE_THRESHOLD=0.6
CORRELATION_ENABLED=true

# Alert Dispatcher - Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alert Dispatcher - Email
EMAIL_FROM=alerts@yourdomain.com
EMAIL_TO=commander@yourdomain.com,security@yourdomain.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your_app_password

# WebSocket
WS_PORT=50000
